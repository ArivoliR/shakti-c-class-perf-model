__pycache__/
*.py[cod]
.pytest_cache/
.trace-cache/
docs/*.aux
docs/*.log
docs/*.out
results/*.aux
results/*.log
results/*.out
results/.texmf-var/
results/missfont.log

# Held-out design-point sweeps: build logs, simulators, and per-point RTL
# traces. One runs-* directory per core/benchmark combination; each holds
# hundreds of MB of commit traces and a copy of the Verilator binary, and all
# of it is regenerable from rtl_sweep.py.
holdout/runs/
holdout/runs-*/
holdout/sweep-*.log
holdout/sensitivity.json

# Standalone scheduler synthesis/lint products.
scheduler_rtl/build/
scheduler_rtl/scheduler_sweep.json

# Local explorations and regenerated study outputs.  Named result snapshots
# are intentionally versioned; only tmp_-prefixed outputs are scratch data.
tmp_*.py
results/tmp_*.json
holdout/tmp_*.py
holdout/runs_*_tmp/

# Linux/Android trace harness products.  The scripts and documentation under
# linux-traces/ are versioned; downloaded source trees, binaries and logs are
# reproducible and can be hundreds of megabytes.
linux-traces/tmp_*
